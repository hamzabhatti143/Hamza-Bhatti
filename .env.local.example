# ── AI agent backend (visitor-chat + admin-chat API routes) ──
# RAG backend URL. Server-side only. Used by app/api/visitor-chat and
# app/api/admin-chat. If unset, the routes fall back to http://localhost:8000.
RAG_BACKEND_URL=https://hamzabhatti-portfolio-agent.hf.space

# Optional: exposes the backend URL to server components for live portfolio data
# (lib/getPortfolio.ts). Safe to leave unset — it falls back to local data.
# NEXT_PUBLIC_BACKEND_URL=https://hamzabhatti-portfolio-agent.hf.space

# ── Admin panel (/admin) ──
# Server-side secret the /api/admin-chat route checks before proxying to the backend.
ADMIN_PASSWORD=change-me
# Client-side gate for the /admin login form. Must match ADMIN_PASSWORD.
# NOTE: NEXT_PUBLIC_* vars are shipped to the browser — this only gates the UI,
# real protection is the server-side ADMIN_PASSWORD check above.
NEXT_PUBLIC_ADMIN_PASSWORD=change-me

# ── Contact form (Resend) ──
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=
